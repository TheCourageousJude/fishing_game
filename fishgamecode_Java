    private int addPointsForCatch() {
        int difficulty = parseDifficulty();
        String fishType = (String) fishTypeCombo.getSelectedItem();
        int stageIdx = currentStage - 1;
        boolean isHyper = "HYPER".equals(fishType);
        int baseValue = STAGE_BASE_VALUES[stageIdx][isHyper ? 1 : 0];
        FishAI.Type type = FishAI.Type.valueOf(fishType);
        double bonus = FISH_BONUS[type.ordinal()];
        int points = (int) Math.round(baseValue * bonus * (0.5 + difficulty / 100.0) * priceMultiplier);
        stageScore += points;
        totalScore += points;
        scoreLabel.setText("Score: " + stageScore + "g");
        if (flashTimer != null) flashTimer.stop();
        flashTimer = new Timer(200, e -> { scoreLabel.setForeground(new Color(200, 220, 255)); flashTimer = null; });
        flashTimer.setRepeats(false);
        scoreLabel.setForeground(Color.YELLOW);
        flashTimer.start();
        useBobber();
        return points;
    }


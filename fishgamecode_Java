    private boolean addBobberToInventory(int type, int cost) {
        for (int i = 0; i < 5; i++) {
            if (bobberInventory[i] == 0) {
                bobberInventory[i] = 10;
                bobberTypes[i] = type;
                return true;
            }
        }
        return false;
    }

    private void updateInventorySlots() {
        for (int i = 0; i < 5; i++) {
            if (bobberInventory[i] > 0) {
                String typeIcon = bobberTypes[i] == 1 ? "🔵" : bobberTypes[i] == 2 ? "🔴" : bobberTypes[i] == 3 ? "🟡" : "📦";
                inventorySlots[i].setText(typeIcon + " " + bobberInventory[i]);
                inventorySlots[i].setBackground(bobberTypes[i] == 1 ? new Color(173, 216, 230) :
                                               bobberTypes[i] == 2 ? new Color(255, 182, 193) :
                                               bobberTypes[i] == 3 ? new Color(255, 215, 0) :
                                               new Color(180, 180, 180));
            } else {
                inventorySlots[i].setText("📦");
                inventorySlots[i].setBackground(new Color(180, 180, 180));
            }
        }
    }

    private void useBobber() {
        for (int i = 0; i < 5; i++) {
            if (bobberInventory[i] > 0) {
                bobberInventory[i]--;
                if (bobberTypes[i] == 1) currentDecayRate = -2;
                else if (bobberTypes[i] == 2) currentBiteChance = 0.80;
                else if (bobberTypes[i] == 3) priceMultiplier = 2.0;
                if (bobberInventory[i] == 0) {
                    bobberTypes[i] = 0;
                    if (bobberTypes[i] == 1) currentDecayRate = PROGRESS_DECAY_RATE;
                    else if (bobberTypes[i] == 2) currentBiteChance = 0.50;
                    else if (bobberTypes[i] == 3) priceMultiplier = 1.0;
                }
                updateInventorySlots();
                break;
            }
        }
    }


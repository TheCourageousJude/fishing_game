    // ==================== FishAI ====================
    private class FishAI {
        enum Type { SMOOTH, ACTIVE, HYPER, GLIDER }
        private final Random rand = new Random();
        private final Type type;
        private final int barHeight, fishHeight, timerMs;
        private double baseSpeed, difficultyFactor, diffCurve;
        private double y, speed, targetY;
        private int direction = -1, currentDifficulty;
        private double hyperBaseSpeed = 0, hyperJitterBias = 0;
        private int burstCooldownMs = 0, hyperJitterMs = 0, hyperBurstAnimMs = 0;
        private boolean hyperBurstAnimating = false;
        private double hyperBurstStartY = 0, hyperBurstEndY = 0;
        private int directionSwitchMs = 0, directionTimerMs = 0, speedTimerMs = 0;
        private double activeTargetY = 0, activeSpeedPxPerMs = 0, dashMultiplier = 1.0;
        private int activeTravelMs = 0, dashMsRemaining = 0;
        private boolean smoothIsDashing = false;
        private int smoothDashCooldownMs = 0, smoothDashElapsedMs = 0, smoothDashTotalMs = 0, smoothTravelMs = 0;
        private double smoothDashStartY = 0, smoothDashTargetY = 0, smoothTargetY = 0, smoothSpeedPxPerMs = 0;

        public FishAI(Type type, double initialY, int barHeight, int fishHeight, int timerMs, int difficulty) {
            this.type = type; this.y = initialY; this.barHeight = barHeight;
            this.fishHeight = fishHeight; this.timerMs = timerMs;
            this.currentDifficulty = difficulty;
            setDifficulty(difficulty);
            initForType();
        }

        private int randBetween(int min, int max) { return min + rand.nextInt(max - min + 1); }
        private double rollHyperBaseSpeed(int d) {
            int px = d <= 15 ? randBetween(80,120) : d <= 30 ? randBetween(120,180) : d <= 50 ? randBetween(180,260) : d <= 70 ? randBetween(260,360) : d <= 90 ? randBetween(360,480) : randBetween(480,620);
            return px / 100.0;
        }
        private int getHyperBurstDistance(int d) {
            if (d <= 14) return randBetween(23,38); if (d <= 30) return randBetween(38,56);
            if (d <= 50) return randBetween(56,94); if (d <= 70) return randBetween(75,131);
            if (d <= 90) return randBetween(94,169); return randBetween(101,188);
        }
        private double pickHyperNewTarget() {
            int bottom = barHeight - fishHeight;
            int dist = getSmoothSubtleDistance(currentDifficulty);
            targetY = rand.nextBoolean() ? Math.min(bottom, y + dist) : Math.max(0, y - dist);
            return targetY;
        }
        private void initForType() {
            switch (type) {
                case SMOOTH: initSmoothAI(currentDifficulty); return;
                case ACTIVE: initActiveAI(currentDifficulty); break;
                case HYPER:
                    hyperBaseSpeed = rollHyperBaseSpeed(currentDifficulty);
                    speed = hyperBaseSpeed * difficultyFactor;
                    targetY = pickHyperNewTarget();
                    burstCooldownMs = randBetween(50,100); hyperJitterMs = randBetween(50,150);
                    break;
                case GLIDER:
                    speed = rollGliderSpeed(currentDifficulty);
                    speedTimerMs = 1500 + rand.nextInt(1500);
                    directionSwitchMs = rollDirectionSwitchMs(currentDifficulty);
                    directionTimerMs = directionSwitchMs;
                    direction = rand.nextBoolean() ? 1 : -1;
                    break;
            }
            if (type != Type.GLIDER) speed = baseSpeed * difficultyFactor;
        }
        public void setDifficulty(int difficulty) {
            int d = Math.max(1, Math.min(100, difficulty));
            diffCurve = Math.pow(d / 100.0, 1.4);
            difficultyFactor = 0.35 + diffCurve * 1.05;
            if (type == Type.GLIDER) { speed = rollGliderSpeed(d); directionSwitchMs = rollDirectionSwitchMs(d); directionTimerMs = directionSwitchMs; }
            else if (type == Type.HYPER) { hyperBaseSpeed = rollHyperBaseSpeed(d); speed = hyperBaseSpeed * difficultyFactor; if (!hyperBurstAnimating) pickHyperNewTarget(); }
        }
        public double update(int tickMs, int difficulty) {
            if (difficulty != currentDifficulty) { currentDifficulty = difficulty; setDifficulty(difficulty); }
            switch (type) {
                case SMOOTH: doSmoothTick(tickMs, difficulty); break;
                case ACTIVE: doActiveTick(tickMs); break;
                case HYPER: doHyperTick(tickMs); break;
                case GLIDER: doGliderTick(tickMs); break;
            }
            return y = Math.max(0, Math.min(barHeight - fishHeight, y));
        }
        private void doHyperTick(int tickMs) {
            int bottom = barHeight - fishHeight;
            hyperJitterMs -= tickMs;
            if (hyperJitterMs <= 0) { hyperJitterMs = randBetween(50,150); hyperJitterBias = (rand.nextDouble() - 0.5) * 1.4; }
            if (hyperBurstAnimating) {
                hyperBurstAnimMs -= tickMs;
                if (hyperBurstAnimMs <= 0) { y = hyperBurstEndY; hyperBurstAnimating = false; burstCooldownMs = randBetween(50,100); pickHyperNewTarget(); }
                else {
                    double p = 1.0 - (hyperBurstAnimMs / 150.0);
                    double e = p < 0.5 ? 2*p*p : 1 - Math.pow(-2*p+2, 2)/2;
                    y = hyperBurstStartY + (hyperBurstEndY - hyperBurstStartY) * e + hyperJitterBias * 0.2;
                }
            } else if (burstCooldownMs <= 0 && rand.nextInt(100) < 20 + (int)(diffCurve * 25)) {
                hyperBurstAnimating = true; hyperBurstAnimMs = 150; hyperBurstStartY = y;
                int dist = getHyperBurstDistance(currentDifficulty);
                hyperBurstEndY = Math.max(0, Math.min(bottom, y + (rand.nextBoolean() ? 1 : -1) * dist));
            } else {
                if (burstCooldownMs > 0) burstCooldownMs -= tickMs;
                double diff = targetY - y;
                if (Math.abs(diff) > 1.0) y += (hyperBaseSpeed * 1.25) * Math.signum(diff) + hyperJitterBias * 0.4;
                if (Math.abs(targetY - y) < 2.0) pickHyperNewTarget();
            }
            if (y <= 0 || y >= bottom) pickHyperNewTarget();
        }
        private int rollDirectionSwitchMs(int d) {
            if (d <= 15) return randBetween(1500,2000); if (d <= 30) return randBetween(1250,1490);
            if (d <= 50) return randBetween(1000,1240); if (d <= 70) return randBetween(700,900);
            if (d <= 90) return randBetween(300,600); return randBetween(1200,2100);
        }
        private double rollGliderSpeed(int d) {
            int min = d <= 15 ? 100 : d <= 30 ? 150 : d <= 50 ? 200 : d <= 70 ? 250 : d <= 90 ? 300 : 350;
            int max = d <= 15 ? 200 : d <= 30 ? 275 : d <= 50 ? 350 : d <= 70 ? 425 : d <= 90 ? 500 : 600;
            return (randBetween(min, max) / 100.0) * (1.0 + diffCurve * 0.35);
        }
        private void doGliderTick(int tickMs) {
            speedTimerMs -= tickMs;
            if (speedTimerMs <= 0) { speed = rollGliderSpeed(currentDifficulty); speedTimerMs = 1500+rand.nextInt(1500); }
            if (rand.nextInt(1000) < 7 || directionTimerMs <= 0) { direction *= -1; directionTimerMs = rollDirectionSwitchMs(currentDifficulty); }
            directionTimerMs -= tickMs;
            y += direction * speed;
            if (y <= 0) { y = 0; direction = 1; } else if (y >= barHeight-fishHeight) { y = barHeight-fishHeight; direction = -1; }
        }
        private void initActiveAI(int d) {
            currentDifficulty = d; diffCurve = d/100.0;
            if (y <= 0) y = (barHeight-fishHeight)/2.0;
            pickActiveTarget(d); dashMsRemaining = 0; dashMultiplier = 1.0;
        }
        private void pickActiveTarget(int d) {
            int bottom = barHeight-fishHeight;
            int dist = getDistanceByDifficulty(d), time = getTimeByDifficulty(d);
            boolean down = rand.nextBoolean();
            activeTargetY = Math.max(0, Math.min(bottom, down ? y+dist : y-dist));
            if (activeTargetY == y) activeTargetY = Math.min(bottom, y+dist);
            activeSpeedPxPerMs = Math.abs(activeTargetY-y)/time; activeTravelMs = time;
            if (rand.nextInt(100) < getDashChance(d)) { dashMsRemaining = 500; dashMultiplier = 2.8; }
            else { dashMsRemaining = 0; dashMultiplier = 1.0; }
        }
        private int getDistanceByDifficulty(int d) {
            if (d<=14) return randBetween(10,25); if (d<=30) return randBetween(25,55);
            return randBetween(35,80);
        }
        private int getDashChance(int d) {
            if (d<=14) return 5; if (d<=30) return 10; if (d<=50) return 18;
            if (d<=70) return 30; if (d<=90) return 45; return 60;
        }
        private int getTimeByDifficulty(int d) {
            if (d<=14) return randBetween(300,400); if (d<=30) return randBetween(275,375);
            if (d<=50) return randBetween(250,350); if (d<=70) return randBetween(225,325);
            return randBetween(150,325);
        }
        private void doActiveTick(int tickMs) {
            if (dashMsRemaining > 0) { dashMsRemaining -= tickMs; if (dashMsRemaining <= 0) dashMultiplier = 1.0; }
            double move = activeSpeedPxPerMs * tickMs * dashMultiplier, diff = activeTargetY - y;
            if (Math.abs(diff) <= move || activeTravelMs <= 0) { y = activeTargetY; pickActiveTarget(currentDifficulty); }
            else { y += Math.signum(diff) * move; activeTravelMs -= tickMs; }
            if (y <= 0) y = 0; else if (y >= barHeight-fishHeight) y = barHeight-fishHeight;
        }
        private void initSmoothAI(int d) {
            currentDifficulty = d; diffCurve = d/100.0; y = barHeight-fishHeight;
            smoothIsDashing = false; smoothDashCooldownMs = randBetween(300,600); pickSmoothSubtleMove(d);
        }
        private int getSmoothDashDistance(int d) {
            if (d<=14) return randBetween(30,50); if (d<=30) return randBetween(50,75);
            if (d<=50) return randBetween(75,125); if (d<=70) return randBetween(100,175);
            return randBetween(125,250);
        }
        private int getSmoothSubtleDistance(int d) {
            if (d<=14) return randBetween(10,20); if (d<=30) return randBetween(20,40);
            if (d<=50) return randBetween(30,60); if (d<=70) return randBetween(40,80);
            return randBetween(45,145);
        }
        private boolean rollSmoothDash(int d) { return rand.nextInt(100) < ((d<=50)?30:55); }
        private void startSmoothDash(int d) {
            int bottom = barHeight-fishHeight; smoothIsDashing = true; smoothDashElapsedMs = 0; smoothDashCooldownMs = 800; smoothDashStartY = y;
            int dist = getSmoothDashDistance(d); boolean down = rand.nextBoolean();
            smoothDashTargetY = down ? Math.min(bottom, y+dist) : Math.max(0, y-dist);
            smoothDashTotalMs = (d<=50) ? randBetween(260,340) : randBetween(220,300);
        }
        private void doSmoothDashTick(int tickMs) {
            smoothDashElapsedMs += tickMs; double t = Math.min(1.0, smoothDashElapsedMs/(double)smoothDashTotalMs);
            double curve = 1.0 - Math.pow(1.0-t, 3.2);
            y = smoothDashStartY + (smoothDashTargetY - smoothDashStartY) * curve;
            if (t >= 1.0) { y = smoothDashTargetY; smoothIsDashing = false; pickSmoothSubtleMove(currentDifficulty); }
        }
        private void pickSmoothSubtleMove(int d) {
            int bottom = barHeight-fishHeight; int dist = getSmoothSubtleDistance(d); boolean down = rand.nextBoolean();
            smoothTargetY = down ? Math.min(bottom, y+dist) : Math.max(0, y-dist);
            smoothTravelMs = randBetween(900,1400); smoothSpeedPxPerMs = Math.abs(smoothTargetY-y)/smoothTravelMs;
        }
        private void doSmoothTick(int tickMs, int d) {
            if (smoothDashCooldownMs > 0) smoothDashCooldownMs -= tickMs;
            if (smoothIsDashing) { doSmoothDashTick(tickMs); return; }
            if (smoothDashCooldownMs <= 0 && rollSmoothDash(d)) { startSmoothDash(d); return; }
            double move = smoothSpeedPxPerMs * tickMs, diff = smoothTargetY - y;
            if (Math.abs(diff) <= move) { y = smoothTargetY; pickSmoothSubtleMove(d); }
            else y += Math.signum(diff) * move;
        }
    }

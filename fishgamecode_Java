    private void handleHookClick() {
        if (isFishingMiniGameActive || stageEnded) return;
        switch (fishingState) {
            case IDLE:
                fishingState = FishingState.SEARCHING;
                searchAccumulator = 0;
                updateHookButtonVisuals();
                if (!timer.isRunning()) timer.start();
                break;
            case SEARCHING:
                fishingState = FishingState.IDLE;
                updateHookButtonVisuals();
                break;
            case BITE:
                int[] range = STAGE_DIFFICULTY[currentStage - 1];
                difficultyField.setText(String.valueOf(rand.nextInt(range[1] - range[0] + 1) + range[0]));
                String[] fishTypes = {"SMOOTH", "ACTIVE", "HYPER", "GLIDER"};
                int typeChance = rand.nextInt(100);
                String randomType;
                if (currentStage <= 2) {
                    if (typeChance < 50) randomType = "SMOOTH";
                    else if (typeChance < 85) randomType = "ACTIVE";
                    else if (typeChance < 95) randomType = "HYPER";
                    else randomType = "GLIDER";
                } else if (currentStage <= 4) {
                    if (typeChance < 35) randomType = "SMOOTH";
                    else if (typeChance < 70) randomType = "ACTIVE";
                    else if (typeChance < 90) randomType = "HYPER";
                    else randomType = "GLIDER";
                } else {
                    if (typeChance < 25) randomType = "SMOOTH";
                    else if (typeChance < 55) randomType = "ACTIVE";
                    else if (typeChance < 85) randomType = "HYPER";
                    else randomType = "GLIDER";
                }
                fishTypeCombo.setSelectedItem(randomType);
                fishTypeLabel.setText("Fish type: " + randomType);
                fishingState = FishingState.IDLE;
                updateHookButtonVisuals();
                startFishingMiniGame();
                break;
        }
    }

    private void updateFishingStateMachine() {
        if (isFishingMiniGameActive || stageEnded) return;
        switch (fishingState) {
            case IDLE: break;
            case SEARCHING:
                searchAccumulator += TIMER_MS;
                if (searchAccumulator >= SEARCH_CHECK_MS) {
                    searchAccumulator = 0;
                    if (rand.nextDouble() < currentBiteChance) {
                        fishingState = FishingState.BITE;
                        biteStartTime = System.currentTimeMillis();
                        updateHookButtonVisuals();
                    }
                }
                break;
            case BITE:
                long elapsed = System.currentTimeMillis() - biteStartTime;
                if (elapsed > BITE_WINDOW_MS) {
                    fishingState = FishingState.IDLE;
                    statusLabel.setText("You hooked but there was no fish to hook!");
                    statusLabel.setForeground(Color.ORANGE);
                    updateHookButtonVisuals();
                }
                break;
        }
    }

    private void startFishingMiniGame() {
        isFishingMiniGameActive = true;
        hookButton.setEnabled(false);
        if (fishingOverlay != null) fishingOverlay.setVisible(false);
        resetGame();
        if (!timer.isRunning()) timer.start();
    }

    private void endFishingSession() {
        isFishingMiniGameActive = false;
        fishingState = FishingState.IDLE;
        updateHookButtonVisuals();
        if (waitingForHookFinish) { waitingForHookFinish = false; evaluateStageProgress(); }
    }

    private void updateCountdown() {
        if (!sessionActive) return;
        if (timeRemaining > 0) {
            timeRemaining--;
            int mins = timeRemaining / 60;
            int secs = timeRemaining % 60;
            timerLabel.setText(String.format("%d:%02d", mins, secs));
            if (timeRemaining <= 10) timerLabel.setForeground(Color.RED);
        } else {
            countdownTimer.stop();
            if (isFishingMiniGameActive) {
                waitingForHookFinish = true;
                statusLabel.setText("Time ran out. LAST FISH!");
                statusLabel.setForeground(Color.RED);
                controlGuideLabel.setText("");
            } else {
                evaluateStageProgress();
            }
        }
    }

    private void evaluateStageProgress() {
        sessionActive = false;
        stageEnded = true;
        hookButton.setEnabled(false);
        if (stageScore >= STAGE_TARGET) {
            // ✅ CHECK IF THIS IS THE FINAL STAGE
            if (currentStage == MAX_STAGES) {
                // ✅ GO DIRECTLY TO VICTORY (no shop after Stage 5!)
                JOptionPane.showMessageDialog(this,
                    "🎉 Stage " + currentStage + " Complete!\n" +
                    "You earned " + stageScore + "g (Target: " + STAGE_TARGET + "g)\n" +
                    "🏆 You've completed all stages!",
                    "Final Stage Complete!", JOptionPane.INFORMATION_MESSAGE);
                Container parent = getParent();
                while (parent != null && !(parent instanceof FishgameTest)) parent = parent.getParent();
                if (parent instanceof FishgameTest) {
                    FishgameTest frame = (FishgameTest) parent;
                    frame.cardLayout.show(frame.mainPanel, FishgameTest.VICTORY);
                }
            } else {
                // ✅ NORMAL FLOW FOR STAGES 1-4: Go to MARKET
                int fee = CAPTAIN_FEES[currentStage - 1];
                if (stageScore >= fee) {
                    stageScore -= fee;
                    JOptionPane.showMessageDialog(this,
                        "🎉 Stage " + currentStage + " Complete!\n" +
                        "You earned " + (stageScore + fee) + "g. Great job!\n" +
                        "💰 Captain's Fee: " + fee + "g deducted!\n" +
                        "Remaining for shop: " + stageScore + "g\n" +
                        "Visit the fishmonger to spend your gold!",
                        "Success!", JOptionPane.INFORMATION_MESSAGE);
                    Container parent = getParent();
                    while (parent != null && !(parent instanceof FishgameTest)) parent = parent.getParent();
                    if (parent instanceof FishgameTest) {
                        FishgameTest frame = (FishgameTest) parent;
                        frame.updateMarketDisplay(stageScore, currentStage);
                        frame.cardLayout.show(frame.mainPanel, FishgameTest.MARKET);
                    }
                } else {
                    JOptionPane.showMessageDialog(this,
                        "💔 Game Over!\n" +
                        "You earned " + stageScore + "g but couldn't pay the Captain's fee!\n" +
                        "Fee required: " + fee + "g\n" +
                        "You had: " + stageScore + "g\n" +
                        "That's all for the trip today. Back home we go.",
                        "GAME OVER", JOptionPane.WARNING_MESSAGE);
                    resetAllProgress();
                    Container parent = getParent();
                    while (parent != null && !(parent instanceof FishgameTest)) parent = parent.getParent();
                    if (parent instanceof FishgameTest) {
                        FishgameTest frame = (FishgameTest) parent;
                        frame.cardLayout.show(frame.mainPanel, FishgameTest.MENU);
                    }
                }
            }
        } else {
            JOptionPane.showMessageDialog(this,
                "💔 Game Over!\n" +
                "You only earned " + stageScore + "g\n" +
                "Target was " + STAGE_TARGET + "g\n" +
                "That's all for the trip today. Back home we go.",
                "GAME OVER", JOptionPane.WARNING_MESSAGE);
            resetAllProgress();
            Container parent = getParent();
            while (parent != null && !(parent instanceof FishgameTest)) parent = parent.getParent();
            if (parent instanceof FishgameTest) {
                FishgameTest frame = (FishgameTest) parent;
                frame.cardLayout.show(frame.mainPanel, FishgameTest.MENU);
            }
        }
    }


    public void purchaseRodUpgrade() {
        int[] prices = {250, 500, 1000, 2500, 5000, 10000};
        if (rodLevel >= prices.length) {
            JOptionPane.showMessageDialog(this, "Rod already at max level!", "Max Level", JOptionPane.INFORMATION_MESSAGE);
            return;
        }
        int cost = prices[rodLevel];
        if (stageScore >= cost) {
            stageScore -= cost;
            rodLevel++;
            greenHeight += 10;
            greenZone.setBounds(3, 0, barWidth - 6, greenHeight);
            updateMarketDisplay();
            refreshMarketInventory();
            JOptionPane.showMessageDialog(this, "🎣 Rod Upgraded to Level " + rodLevel + "!\nGreen zone increased by 10 pixels!", "Upgrade Success", JOptionPane.INFORMATION_MESSAGE);
        } else {
            JOptionPane.showMessageDialog(this, "Not enough gold! Need " + cost + "g\nYou have: " + stageScore + "g", "Insufficient Funds", JOptionPane.WARNING_MESSAGE);
        }
    }


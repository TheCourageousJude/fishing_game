    private void gameTick() {
        tickCounter++;
        updateFishingStateMachine();
        if (isFishingMiniGameActive && !stageEnded) {
            int difficulty = parseDifficulty();
            if (newRound) { barVelocity += GRAVITY; newRound = false; }
            else barVelocity += spacePressed ? -UP_ACCEL : GRAVITY;
            barVelocity = Math.max(-MAX_BAR_SPEED, Math.min(MAX_BAR_SPEED, barVelocity));
            greenY += barVelocity;
            if (greenY < 0) { greenY = 0; if (barVelocity < 0) barVelocity = 0; }
            else if (greenY + greenHeight > barHeight) { greenY = barHeight - greenHeight; if (barVelocity > 0) barVelocity = 0; }
            greenZone.setLocation(3, greenY);
            if (fishAI == null) fishAI = new FishAI(FishAI.Type.SMOOTH, barHeight - 30, barHeight, 30, TIMER_MS, difficulty);
            fishY = fishAI.update(TIMER_MS, difficulty);
            fishBox.setLocation(3, (int) fishY);
            boolean inGreen = fishY + 30 > greenY && fishY < greenY + greenHeight;
            greenProgressWidth += inGreen ? PROGRESS_FILL_RATE : currentDecayRate;
            greenProgressWidth = Math.max(0, Math.min(barHeight, greenProgressWidth));
            greenProgress.setBounds(0, barHeight - greenProgressWidth, 25, greenProgressWidth);
            redProgress.setBounds(0, 0, 25, barHeight - greenProgressWidth);
            // ✅ FISH CAUGHT - Show in resultLabel (NO JOptionPane)
            if (greenProgressWidth >= barHeight) {
                timer.stop();
                int points = addPointsForCatch();
                resultLabel.setText("🎣 Fish Caught! +" + points + "g");
                resultLabel.setForeground(new Color(100, 255, 100));
                Timer clearTimer = new Timer(2500, e -> {
                    if (!isFishingMiniGameActive && fishingState == FishingState.IDLE) {
                        updateHookButtonVisuals();
                    }
                });
                clearTimer.setRepeats(false);
                clearTimer.start();
                endFishingSession();
            }
            // ✅ FISH ESCAPED - Show in resultLabel (NO JOptionPane)
            else if (greenProgressWidth <= 0 && tickCounter > 10) {
                timer.stop();
                resultLabel.setText("💨 Fish got away!");
                resultLabel.setForeground(Color.RED);
                Timer clearTimer = new Timer(2500, e -> {
                    if (!isFishingMiniGameActive && fishingState == FishingState.IDLE) {
                        updateHookButtonVisuals();
                    }
                });
                clearTimer.setRepeats(false);
                clearTimer.start();
                endFishingSession();
            }
        }
    }

